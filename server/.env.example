DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simplycrm?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# --- Email (AWS SES) — optional, see SETUP.md ---
# Credentials are NOT set here: the AWS SDK picks them up from the standard
# credential chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars locally,
# an IAM role automatically in deployment). Never put an access key in this
# file or any other file that gets committed.
AWS_REGION="us-east-1"
SES_SENDING_DOMAIN="mail.simplycrm.app"
SES_CONFIGURATION_SET="simplycrm-transactional"
SES_FROM_ADDRESS="notifications@mail.simplycrm.app"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email receiving (IMAP) — optional, see EMAIL_SPEC.md §5 ---
# A single shared mailbox the background worker polls for INBOX + Sent;
# this is a real password (or app-specific password for providers that
# require one with 2FA), gitignored same as everything else in this file —
# never commit a filled-in copy of this file.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
# Folder names vary by provider (e.g. Gmail uses "[Gmail]/Sent Mail").
IMAP_INBOX_FOLDER="INBOX"
IMAP_SENT_FOLDER="Sent"
IMAP_POLL_INTERVAL_MS=60000
