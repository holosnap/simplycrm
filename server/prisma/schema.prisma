generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum ActivityType {
  note
  call
  email
  meeting
}

enum TaskStatus {
  open
  done
}

enum DealStage {
  prospecting
  qualification
  proposal
  negotiation
  closed_won
  closed_lost
}

enum CustomFieldType {
  text
  number
  date
  boolean
}

enum CustomFieldAppliesTo {
  contact
  company
}

enum EmailDirection {
  outbound
  inbound
}

enum EmailMessageStatus {
  queued
  sending
  sent
  delivered
  bounced
  complained
  failed
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String
  role          Role      @default(user)
  signatureText String?   @map("signature_text")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastLoginAt   DateTime? @map("last_login_at")

  ownedContacts Contact[]      @relation("ContactOwner")
  ownedDeals    Deal[]         @relation("DealOwner")
  activities    Activity[]
  tasks         Task[]
  emailMessages EmailMessage[]

  @@map("users")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  domain    String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts Contact[]
  deals    Deal[]

  @@map("companies")
}

model Contact {
  id        String   @id @default(uuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String?
  phone     String?
  title     String?
  companyId String?  @map("company_id")
  ownerId   String?  @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         User?          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags          ContactTag[]
  activities    Activity[]
  tasks         Task[]
  deals         Deal[]
  emailThreads  EmailThread[]
  emailMessages EmailMessage[]

  @@map("contacts")
}

model Deal {
  id                String    @id @default(uuid())
  title             String
  amount            Decimal   @db.Decimal(12, 2)
  stage             DealStage @default(prospecting)
  companyId         String?   @map("company_id")
  contactId         String?   @map("contact_id")
  ownerId           String?   @map("owner_id")
  expectedCloseDate DateTime? @map("expected_close_date")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner         User?          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities    Activity[]
  emailThreads  EmailThread[]
  emailMessages EmailMessage[]

  @@index([companyId])
  @@index([contactId])
  @@map("deals")
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  contacts ContactTag[]

  @@map("tags")
}

model ContactTag {
  contactId String @map("contact_id")
  tagId     String @map("tag_id")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model CustomFieldDefinition {
  id        String               @id @default(uuid())
  name      String
  fieldType CustomFieldType      @map("field_type")
  appliesTo CustomFieldAppliesTo @map("applies_to")

  values CustomFieldValue[]

  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id       String @id @default(uuid())
  fieldId  String @map("field_id")
  recordId String @map("record_id")
  value    String

  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("custom_field_values")
}

model Activity {
  id         String       @id @default(uuid())
  contactId  String       @map("contact_id")
  dealId     String?      @map("deal_id")
  authorId   String       @map("author_id")
  type       ActivityType
  body       String
  occurredAt DateTime     @default(now()) @map("occurred_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([dealId])
  @@map("activities")
}

model Task {
  id          String     @id @default(uuid())
  contactId   String?    @map("contact_id")
  assigneeId  String     @map("assignee_id")
  title       String
  description String?
  dueAt       DateTime?  @map("due_at")
  status      TaskStatus @default(open)
  createdAt   DateTime   @default(now()) @map("created_at")
  completedAt DateTime?  @map("completed_at")

  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignee User     @relation(fields: [assigneeId], references: [id], onDelete: Restrict)

  @@map("tasks")
}

model EmailThread {
  id            String    @id @default(uuid())
  contactId     String?   @map("contact_id")
  dealId        String?   @map("deal_id")
  subject       String
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  contact  Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal     Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  messages EmailMessage[]

  @@index([contactId])
  @@index([dealId])
  @@map("email_threads")
}

// One row per outbound send attempt (also doubles as the send queue — see
// CLAUDE.md "Email send queue") and, later, per received message. `status` +
// `attempts` + `nextAttemptAt` are queue bookkeeping, not just a status
// snapshot; `sesMessageId` is the API-level id SES returns on send (joins to
// events); `rfc822MessageId` is the header-level Message-ID we generate
// ourselves for threading — the two are deliberately not the same value,
// see EMAIL_SPEC.md §4.
model EmailMessage {
  id              String             @id @default(uuid())
  threadId        String             @map("thread_id")
  contactId       String?            @map("contact_id")
  dealId          String?            @map("deal_id")
  direction       EmailDirection
  authorId        String?            @map("author_id")
  sesMessageId    String?            @unique @map("ses_message_id")
  rfc822MessageId String             @unique @map("rfc822_message_id")
  inReplyTo       String?            @map("in_reply_to")
  fromAddress     String             @map("from_address")
  toAddresses     String[]           @map("to_addresses")
  ccAddresses     String[]           @map("cc_addresses")
  subject         String
  bodyText        String?            @map("body_text")
  bodyHtml        String?            @map("body_html")
  status          EmailMessageStatus @default(queued)
  attempts        Int                @default(0)
  nextAttemptAt   DateTime?          @map("next_attempt_at")
  lastError       String?            @map("last_error")
  // Set when this row was found (or confirmed) via the IMAP sync worker —
  // null for a message that only exists because we sent it via SES and
  // haven't seen it echoed back in the mailbox yet. See EMAIL_SPEC.md §5.
  imapUid         BigInt?            @map("imap_uid")
  imapFolder      String?            @map("imap_folder")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  sentAt          DateTime?          @map("sent_at")

  thread      EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  contact     Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal        Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  author      User?             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments EmailAttachment[]

  @@index([status, nextAttemptAt])
  @@index([threadId])
  @@map("email_messages")
}

// Attachment bytes live in S3, never Postgres — see CLAUDE.md "Email
// attachments". `declaredContentType` is whatever the sender/compose request
// claimed; `detectedContentType` is sniffed from the actual bytes
// (server/src/lib/attachmentStorage.ts, via magic-byte detection) and may be
// null when the format isn't detectable (e.g. plain text, CSV) — callers
// must not trust `declaredContentType` alone for anything security-sensitive
// (e.g. deciding how to render it), and `filename` is sender-supplied and
// must never be trusted for filesystem paths.
model EmailAttachment {
  id                  String   @id @default(uuid())
  emailMessageId      String   @map("email_message_id")
  filename            String
  declaredContentType String   @map("declared_content_type")
  detectedContentType String?  @map("detected_content_type")
  sizeBytes           Int      @map("size_bytes")
  s3Key               String   @map("s3_key")
  createdAt           DateTime @default(now()) @map("created_at")

  message EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@map("email_attachments")
}

// Per-folder IMAP sync checkpoint (one row per watched folder, e.g. "INBOX",
// "Sent"). UIDs are only meaningful within a given UIDVALIDITY epoch — if the
// server reports a different uidValidity than what's stored here, every
// previously-seen UID is void and the folder must be resynced from scratch;
// see imapSync.ts.
model ImapFolderState {
  id          String   @id @default(uuid())
  folder      String   @unique
  uidValidity BigInt   @map("uid_validity")
  lastSeenUid BigInt   @default(0) @map("last_seen_uid")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("imap_folder_state")
}
